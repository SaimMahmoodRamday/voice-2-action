# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Whisper
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# translate = output English (model handles English/Roman Urdu, not Urdu script)
WHISPER_TASK=translate

# App
UPLOAD_DIR=./uploads

# Notion task execution (OPTIONAL — feature is OFF unless both are set).
# Create an internal integration at https://www.notion.so/my-integrations,
# share your tasks database with it, then copy the token + database id here.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Title property name of your database (Notion defaults a new DB to "Name").
NOTION_TITLE_PROP=Name
